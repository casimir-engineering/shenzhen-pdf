# TestFlight signing config — example.
#
# Copy this file to `.testflight.env` (which is git-ignored) and fill in your
# own Apple Developer signing identities. `build-mac-testflight.sh` sources
# `.testflight.env` automatically, so you can then run it with no arguments:
#
#     ./portable/build-mac-testflight.sh
#
# Find the exact identity strings in your keychain with:
#
#     security find-identity -v          # lists the app + installer certs
#
export MAC_BUNDLE_ID="com.example.yourapp"
export MAC_APPSTORE_IDENTITY="Apple Distribution: Your Name (TEAMID1234)"
export MAC_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: Your Name (TEAMID1234)"
export MAC_PROVISIONING_PROFILE="$HOME/Downloads/YourApp_AppStore.provisionprofile"

# Version and build change every release, so pass them on the command line
# rather than pinning them here, e.g.:
#
#     MAC_VERSION=26.6.19 MAC_BUILD=1 ./portable/build-mac-testflight.sh
